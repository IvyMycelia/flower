import "src/stdlib/string.flo" as s

func main(): int
    name: string = "Ivy"
    mt: string = ""

    if s.is_empty(mt): print("Pass!\n")
    else: print("False!\n")
    end

    if s.starts_with(name, "I"): print("Pass!\n")
    else: print("False!\n")
    end

    if s.starts_with(name, "I"): print("Pass!\n")
    else: print("False!\n")
    end

    if not s.ends_with(name, "I"): print("Pass!\n")
    else: print("False!\n")
    end

    if s.find_char(mt, ' ') == -1: print("Pass!\n")
    else: print("False!\n")
    end

    return 0
end