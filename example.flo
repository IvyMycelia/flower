// This is an example of how a "Person" struct might be implemented with specific data access

/*
prop      = exported / visible outside module
readonly  = readable outside module, writable only inside module
hidden    = not readable or writable outside module
frozen    = assignable once
get       = computed property, never assignable
*/
// All of the above serve as top-level indicators. structs, unions, and functions are all considered private by default. 
// Any struct / union / other piece of data that is prefixed by a `prop` keyword is considered public, including all of its sub data
// Any sub data under any struct / union, regardless of `prop` presence, can have its flags refined by deeper-scope flags, e.g. a propagated struct with a single field as hidden means that the hidden field can not be accessed outside of the struct's source file. This logic applies to all flags. Children inherit their parent's flags, but can have flags of their own that override / add on

import "date.flo" // No alias, namespace is `utils`

prop struct Person {
    readonly name: { // Name and its fields can NOT be manipulated by an outside module
        frozen first: string, // Once set, the field `first` can NOT be manipulated ANYWHERE
        middle: string, // Editable within same module
        last: string // Editable within same module
    },
    
    readonly frozen birthday: {
        day: int, 
        month: int, 
        year: int 
    }, // Readable from outside, can only be set ONCE within the module itself

    get age: int
        return date.current_date - date.date(birthday) // age is treated as a getter, you can do something like `print(person.age)` and it'd work. Essentially, the `get` keyword means it's a function that runs on call
    end
    
    hidden frozen social_security_number: int, // Can not be accessed (write OR read) from outside the module; can only be set ONCE
    
    children: Person[] // Universally visible and editable
}

prop func create(first_name: string, middle_name: string, last_name: string, birth_day: int, birth_month: int, birth_year: int, ssn: int, children: Person[]): Person
    person: Person = new Person

    person.name = { first_name, middle_name, last_name }
    // or `person.name.first = first_name` etc
    
    person.birthday.day = birth_day
    person.birthday.month = birth_month
    person.birthday.year = birth_year
    // or the other format

    person.social_security_number = ssn

    person.children = children

    return person
end

prop func create(name: { first_name: string, middle_name: string, last_name: string }, birthday: { day: int, month: int, year: int }, ssn: int, children: Person[]): Person
    person: Person = new Person

    person.name = name
    // or `person.name.first = name.first_name` etc
    
    person.birthday.day = birthday.day
    person.birthday.month = birthday.month
    person.birthday.year = birthday.year
    // or the other format

    person.social_security_number = ssn

    person.children = children

    return person
end

// ASSUME FOR THIS NEXT PIECE OF CODE, IT'S IN A FILE CALLED "info.flo" AND IS NOT SUPPOSED TO BE ABLE TO ACCESS EVERYTHING
import "person_maker.flo" as person // alias, namespace is `person` instead of `person_maker`

func main(): int
    Ivy: Person = person.create("Ivy", "S", "C", 7, 4, 2009, 123456789, null)
    Jeff: Person = person.create({ "Jeff", "Stiel", "C" }, { 1, 10, 1988 }, 012345678, { Ivy, person.create("Willow", "Ross", "C", 1, 5, 2008, 012345679, null) })

    t: int = Jeff.social_security_number
    // Error: Field "social_security_number" does not exist in this scope.
    
    Jeff.age = 5
    // Error: Field "age" is a getter and cannot be assigned.

    Jeff.name.first = "Bob"
    // Error: Field "name" is readonly from this scope.
    // Error (from inside the module): Field "first" is frozen and can not be reassigned.

    Jeff.name.last = "Bobberson"
    // Error: Field "name" is readonly from this scope.
    // No error when within the same module it was defined in

    Jeff.birthday = { 5, 5, 5 }
    // Error: Field "birthday" is readonly from this scope.
    // Error: Field "birthday" is frozen and can not be reassigned.

    print(Jeff.social_security_number)
    // Error: Field "social_security_number" does not exist in this scope.
end




// MVP version of "person_maker.flo"

struct Name {
    frozen first_name: string,
    middle_name: string,
    last_name: string
} // `Name` is not accessible outside the module

struct Birthday {
    day: int,
    month: int,
    year: int
} // `Birthday` is not accessible outside the module

prop struct Person {
    readonly name: Name,
    readonly frozen birthday: Birthday,
    get age: int
        return current_date - date(birthday)
    end
    hidden frozen social_security_number: int,
    children: Person[]
} // `Person` is accessible outside the module

