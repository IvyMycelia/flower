import <stdio>

func add(a: int, b: int): int
    return a + b
end

func multiply(a: int, b: int): int
    return a * b
end

prop func test(): bool
    x: int = add(1, 2)
    if x == 3:
        y: int = multiply(3, 4)
        if y == 12:
            return true
        end
    end
    return false
end