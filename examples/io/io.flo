import <stdio>

import "examples/io/print.flo" as prints
import "examples/io/integer_print.flo" as integer

prop func test(): bool
    total: int = 0
    pass: int = 0

    print("  print... ")
    total = total + 1
    print("\'")
    if prints.test():
        print("\' ")
        pass = pass + 1
        print("OK\n")
    else:
        print("FAIL\n")
    end

    print("  integer print...")
    total = total + 1
    print("\'")
    if prints.test():
        print("\' ")
        pass = pass + 1
        print("OK\n")
    else:
        print("FAIL\n")
    end

    if pass == total:
        print("  IO: All Passed!\n")
    else:
        print("  IO: Some Failed!\n")
    end

    return pass == total
end