import <stdio>

struct Vector2 {
    x: int,
    y: int
}

struct Vector3 {
    x: int,
    y: int,
    z: int
}

type Value = int | string

struct Box {
    value: Value
}

// type MaybeValue = string | null

// struct MaybeBox {
//     value: MaybeValue
// }

prop func test(): bool
    p: @Vector2 = new Vector2
    p.x = 5
    p.y = 10

    if p.x != 5:
        prune p
        return false
    end

    if p.y != 10:
        prune p
        return false
    end

    p2: @Vector3 = new Vector3
    p2.x = 1
    p2.y = 2
    p2.z = 3
    
    if p2.z != 3:
        prune p
        prune p2
        return false
    end

    prune p
    prune p2

    box: @Box = new Box

    box.value = 7
    first: Value = box.value
    if first is int:
        n: int = first as int
        if n != 7:
            prune box
            return false
        end
    else:
        prune box
        return false
    end

    box.value = "Ivy"
    second: Value = box.value
    if second is string:
        s: string = second as string
        if s != "Ivy":
            prune box
            return false
        end

        if s.length != 3:
            prune box
            return false
        end
    else:
        prune box
        return false
    end

    prune box

    // maybe_box: @MaybeBox = new MaybeBox
    // maybe_box.value = null

    // if maybe_box.value != null:
    //     prune maybe_box
    //     return false
    // end

    // maybe_box.value = "Rose"
    // if maybe_box.value != null:
    //     label: string = maybe_box.value as string
    //     if label != "Rose":
    //         prune maybe_box
    //         return false
    //     end
    // else:
    //     prune maybe_box
    //     return false
    // end

    // prune maybe_box

    return true
end