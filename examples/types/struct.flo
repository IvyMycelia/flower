import <stdio>

struct Vector2 {
    x: int,
    y: int
}

struct Vector3 {
    x: int,
    y: int,
    z: int
}

type Value = int | string

struct Box {
    value: Value
}

prop func test(): bool
    p: @Vector2 = new Vector2
    p.x = 5
    p.y = 10
    if p.x == 5:
        if p.y == 10:
            p2: @Vector3 = new Vector3
            p2.x = 1
            p2.y = 2
            p2.z = 3
            if p2.z == 3:
                return true
            end
            prune p2
        end
    end

    box: @Box = new Box

    box.value = 7
    first: Value = box.value
    if first is int:
        n: int = first as int
        if n != 7:
            prune box
            prune p
            return false
        end
    else:
        prune box
        prune p
        return false
    end

    box.value = "Ivy"
    second: Value = box.value
    if second is string:
        s: string = second as string
        if s != "Ivy":
            prune box
            prune p
            return false
        end

        if s.length != 3:
            prune box
            prune p
            return false
        end
    else:
        prune box
        prune p
        return false
    end

    prune box
    
    prune p
    return false
end