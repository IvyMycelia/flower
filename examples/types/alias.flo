type Count = int
type Total = Count
type Name = string

type Value = int | string
type MaybeValue = ?Value

struct Pair {
    left: Count,
    right: Total,
}

func identity(x: Count): Total
    return x
end

prop func test(): bool
    n: Count = 12
    total: Total = identity(n)
    name: Name = "Ivy"
    pair: Pair

    pair.left = n
    pair.right = total

    if pair.left != 12:
        return false
    end

    if pair.right != 12:
        return false
    end

    if name != "Ivy":
        return false
    end

    if name.length != 3:
        return false
    end

    maybe: MaybeValue = null

    maybe = 7
    if maybe is int:
        real_int: int = maybe as int
        if real_int != 7:
            return false
        end
    else:
        return false
    end

    maybe = "Ivy"
    if maybe is string:
        real_name: string = maybe as string
        if real_name != "Ivy": 
            return false
        end
    else:
        return false
    end

    maybe = null
    if maybe != null:
        return false
    end

    return true
end