import <stdio>
import <stdlib>

type MaybeInt = ?int
type MaybeName = ?string
type MaybePtr = ?@int

func pass_name(name: ?string): ?string
    return name
end

func pass_count(value: ?int): ?int
    return value
end

prop func test(): bool
    count: MaybeInt = null
    name: MaybeName = null
    ptr: MaybePtr = null

    if count != null:
        return false
    end

    count = pass_count(7)
    if count == null:
        return false
    end

    if count is int:
        real_count: int = count as int
        if real_count != 7:
            return false
        end
    else:
        return false
    end

    name = pass_name(null)
    if name != null:
        return false
    end

    name = "Ivy"
    if name == null:
        return false
    end

    if name is string:
        real_name: string = name as string
        if real_name.length != 3:
            return false
        end
        
        if real_name != "Ivy":
            return false
        end
    else:
        return false
    end

    raw: @int = new int
    ptr = raw

    if ptr == null:
        prune raw
        return false
    end

    if ptr is @int:
        live_ptr: @int = ptr as @int
        @live_ptr = 11
        if @raw != 11:
            prune raw
            return false
        end
    else:
        prune raw
        return false
    end

    casted_name: MaybeName = "Rue" as MaybeName
    if casted_name is string:
        real_casted: string = casted_name as string
        if real_casted != "Rue":
            prune raw
            return false
        end
    else:
        prune raw
        return false
    end

    prune raw
    return true
end