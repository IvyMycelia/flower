type MaybeInt = ?@int
type Value = int | string

prop func test(): bool
    raw: @int = new int
    @raw = 7

    maybe: MaybeInt = raw

    if maybe == null:
        prune raw
        return false
    else:
        real: @int = maybe as @int
        if @real != 7:
            prune raw
            return false
        end
    end

    maybe = null

    if maybe != null:
        prune raw
        return false
    else:
        if maybe != null:
            prune raw
            return false
        end
    end

    maybe = raw
    
    if maybe == null:
        prune raw
        return false
    end

    guarded_ptr: @int = maybe as @int
    if @guarded_ptr != 7:
        prune raw
        return false
    end

    value: Value = "Rose"

    if value is int:
        prune raw
        return false
    else:
        s: string = value as string
        if s != "Rose":
            prune raw
            return false
        end

        if s.length != 4:
            prune raw
            return false
        end
    end

    value = 7

    if value is string:
        prune raw
        return false
    end

    guarded_num: int = value as int
    if guarded_num != 7:
        prune raw
        return false
    end

    value = "Lily"

    if value is int:
        prune raw
        return false
    end

    guarded_str: string = value as string
    if guarded_str != "Lily":
        prune raw
        return false
    end

    if guarded_str.length != 4:
        prune raw
        return false
    end

    prune raw
    return true
end