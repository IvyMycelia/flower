import <stdio>
import <string>

prop func test(): bool
    name: string = "Ivy" as string
    raw: @char = name as @char
    other: string = raw as string
    empty: string = "" as string
    literal_raw: @char = "Flower"

    first: char = name[0]
    second: char = name[1]
    raw_last: char = raw[2]

    if name != other:
        return false
    end

    if name == "Nova" as string:
        return false
    end

    if name != "Ivy" as string:
        return false
    end

    if name.length != 3:
        return false
    end

    if other.length != 3:
        return false
    end

    if empty.length != 0:
        return false
    end

    if first != 'I':
        return false
    end

    if second != 'v':
        return false
    end

    if raw_last != 'y':
        return false
    end

    if strcmp(raw, "Ivy") != 0:
        return false
    end

    if strcmp(literal_raw, "Flower") != 0:
        return false
    end
    
    print("\n")
    print(name)
    print("\n")
    print(other)
    print("\n")
    print(first)
    print("\n")

    return true
end