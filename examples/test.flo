import <stdio>
import <stdlib>

import "examples/memory/memory.flo" as memory
import "examples/types/types.flo" as types
import "examples/control/control.flo" as control
import "examples/io/io.flo" as io
import "examples/misc/misc.flo" as misc
import "examples/import/import.flo" as imports

func main(): int
    total: int = 0
    pass: int = 0

    print("\n=== Memory ===\n")
    total = total + 1
    if memory.test():
        pass = pass + 1
    end

    print("\n=== Types ===\n")
    total = total + 1
    if types.test():
        pass = pass + 1
    end

    print("\n=== Control ===\n")
    total = total + 1
    if control.test():
        pass = pass + 1
    end

    print("\n=== IO ===\n")
    total = total + 1
    if io.test():
        pass = pass + 1
    end

    print("\n=== Misc ===\n")
    total = total + 1
    if misc.test():
        pass = pass + 1
    end

    print("\n=== Import ===\n")
    total = total + 1
    if imports.test():
        pass = pass + 1
    end

    print("\n=== Results ===\n")
    if pass == total:
        print("All Passed!\n")
    else:
        print("Some Failed!\n")
    end

    return 0
end