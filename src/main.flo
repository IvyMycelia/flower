import <stdio>
import <ctype>
import <stdlib>
import <unistd>

import "src/stdlib/cstr.flo" as cstr
import "src/globals.flo" as globals
import "src/lexer.flo" as lexer
import "src/ast.flo" as parser
import "src/parser.flo" as parser
import "src/file.flo" as file
import "src/module.flo" as module
import "src/typecheck.flo" as typecheck
import "src/codegen.flo" as codegen

func main(argc: int, argv: @char[]): int
    getcwd(project_root, sizeof(project_root));
    if argc < 2:
        printf("%sMissing arguments! Use -help for usage instructions.%s\n", RED, RESET)
        return -1
    end

    for i in 1..argc:
        arg: @char = argv[i]

        if arg[0] == '-':
            // Skip all leading dashes
            while arg[0] == '-':
                arg = arg + 1
            end

            flag: string = arg as string
            for i in 0..flag.length:
                arg[i] = tolower(arg[i] as char) as char
            end

            if flag == "help" or flag == "h":
                printf("%s🌸 Welcome to Flower Compiler!\n\n%s", GREEN, RESET)
        
                printf("%sUsage:\n%s", BLUE, RESET)
                print("\tflower\t[options] <filepath> [output_path]\n\n")

                printf("%sOptions:\n%s", BLUE, RESET)
                print("\t-help,    -h\tShow this help message\n")
                print("\t-version, -v\tShow the current version of FloC\n")
                print("\t<filepath>\tSpecify the source file to compile")
                print("\t[output_path]\tOptional output binary path\n\n")
        
                printf("%sExample:\n%s", BLUE, RESET)
                print("\tflower -help\n")
                print("\tflower main.flo build/demo\n\n")
        
                printf("%sTips:\n%s", BLUE, RESET)
                print(" - Omit output_path to emit `output/out.c` and `output/out`\n")
                print(" - When output_path is omitted, Flower auto-runs binaries that use `print`\n")
                print(" - You can use any number of dashes before a flag, e.g., ---help\n")
                print(" - Flags are case-insensitive: -HELP works too!\n\n")
        
                printf("%sHappy Compiling with Flower! 🌼\n%s", GREEN, RESET)
                continue
            else if flag == "version" or flag == "v":
                print("Version: 1.3.0\n")
                continue
            else:
                printf("%sUnrecognized flag argument! Use -help for more information.\n%s", RED, RESET)
            end
        else:
            printf("%sCompiling file: %s%s\n", BLUE, argv[i], RESET)
            
            abs_path: char[512]
            realpath(argv[i], abs_path)
            set_current_file(abs_path)

            print("Initializing modules..\n")
            mods: @ModuleSet = new ModuleSet
            init_modules(mods)

            main_mod: @Module = load_module(mods, abs_path)
            if main_mod == null:
                return -1
            end

            print("Checking types..\n")
            type_errors: int = check_modules(mods)
            if type_errors > 0:
                printf("%sTypecheck failed with %d error(s)%s\n", RED, type_errors, RESET)
                return -1
            end

            // Codegen
            out_c: char[512]
            explicit_output: bool = false
            
            if i + 1 < argc and argv[i + 1][0] != '-':
                explicit_output = true
                snprintf(out_c, sizeof(out_c), "%s.c", argv[i + 1])
            else:
                if system("mkdir -p output") != 0:
                    printf("%sFailed to create output directory\n%s", RED, RESET)
                    return -1
                end

                snprintf(out_c, sizeof(out_c), "output/out.c")
            end

            output: @FILE = fopen(out_c, "w")
            if not output:
                printf("%sFailed to open output file\n%s", RED, RESET)
                return -1
            end

            has_output: int = 0
            for j in 0..mods.count:
                m: @Module = mods.modules + j
                if token_stream_contains(m.tokens, TOKEN_PRINT):
                    has_output = 1
                end
            end

            should_run: bool = false
            if has_output and not explicit_output:
                should_run = true
            end

            print("Codegen...\n"); fflush(stdout)
            emit_string_runtime(output)
            emit_includes(mods, output)
            codegen(mods, output)

            prune mods
            fclose(output)

            bin_name: char[512]
            snprintf(bin_name, sizeof(bin_name), "%.*s", (cstr.len(out_c) - 2) as int, out_c)

            build_cmd: char[1024]
            snprintf(build_cmd, sizeof(build_cmd), "clang %s -o %s", out_c, bin_name)

            build_status: int = system(build_cmd)
            if build_status != 0:
                printf("%sFailed to compile generated C outputs%s\n", RED, RESET)
                return -1
            end

            if should_run:
                printf("%s\nOUTPUT:\n", YELLOW)
                fflush(stdout)
                printf("%s", RESET)
                fflush(stdout)
                snprintf(build_cmd, sizeof(build_cmd), "./%s", bin_name)

                run_status: int = system(build_cmd)
                if run_status != 0:
                    printf("%sFailed to run generated binary%s\n", RED, RESET)
                    return -1
                end
            end

            print("\n")
            printf("%sCompiled %s → %s%s\n", GREEN, out_c, bin_name, RESET)
            break
        end
    end
end