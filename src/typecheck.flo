func init_type_env(env: @TypeEnv): void
    env.struct_count = 0
    env.var_count = 0
    env.func_count = 0
    env.error_count = 0
end

func check_modules(mods: @ModuleSet): int
    env: @TypeEnv = new TypeEnv
    init_type_env(env)

    active_type_modules = mods

    for i in 0..mods.count:
        m: @Module = mods.modules + i
        current_type_module = m
        typecheck_collect(env, m.ast, m.src)
    end

    for i in 0..mods.count:
        m: @Module = mods.modules + i
        current_type_module = m
        typecheck_ast(env, m.ast, m.src)
    end

    current_type_module = null

    count: int = env.error_count
    prune env
    return count
end