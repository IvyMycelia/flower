import "./ast.flo"

forward struct StructInfo
forward struct VarInfo
forward struct FuncInfo

struct TypeEnv {
    src: @char,

    structs: StructInfo[256],
    struct_count: int,

    vars: VarInfo[512],
    var_count: int,

    funcs: FuncInfo[256],
    func_count: int,

    error_count: int
}

struct StructInfo {
    name_start: int,
    name_length: int,
    fields: FieldInfo[128],
    field_count: int
}

struct FieldInfo {
    name_start: int,
    name_length: int,
    type: TypeInfo
}

struct VarInfo {
    name_start: int,
    name_length: int,
    type: TypeInfo

    // Simple implementation for now.. will add scope depth and 
    // function ID tracking for more advanced system later
}

struct FuncInfo {
    name_start: int,
    name_length: int,
    return_type: TypeInfo
}