import "src/module.flo" as module
import "src/lexer.flo" as lexer
import "src/ast.flo" as parser
import "src/parser.flo" as parser
import "src/file.flo" as file

forward struct StructInfo
forward struct FieldInfo
forward struct VarInfo
forward struct FuncInfo

struct FieldInfo {
    src: @char,
    name_start: int,
    name_length: int,
    type: TypeInfo
}

struct StructInfo {
    src: @char,
    name_start: int,
    name_length: int,
    fields: FieldInfo[128],
    field_count: int
}

struct VarInfo {
    src: @char,
    name_start: int,
    name_length: int,
    type: TypeInfo

    // Simple implementation for now.. will add scope depth and 
    // function ID tracking for more advanced system later
}

struct FuncInfo {
    src: @char,
    name_start: int,
    name_length: int,
    return_type: TypeInfo
}

// Type Environment, hosts registries and their data
struct TypeEnv {
    src: @char,

    structs: StructInfo[1024],
    struct_count: int,

    vars: VarInfo[2048],
    var_count: int,

    funcs: FuncInfo[1024],
    func_count: int,

    error_count: int
}

active_type_modules: @ModuleSet
current_type_module: @Module

// Helper Functions

func same_name(a_src: @char, a_start: int, a_len: int, b_src: @char, b_start: int, b_len: int): int
    if a_len != b_len:
        return 0
    end

    return not strncmp(a_src + a_start, b_src + b_start, a_len)
end

func copy_type(dst: @TypeInfo, src_type: @TypeInfo): void
    dst.base = src_type.base
    dst.pointer_depth = src_type.pointer_depth
    dst.array_size = src_type.array_size
    dst.arr_size_expr = src_type.arr_size_expr
    dst.name_start = src_type.name_start
    dst.name_length = src_type.name_length
    dst.name_src = src_type.name_src
end

// Utility

func type_error(env: @TypeEnv, ast: @AST, message: @char): void
    printf("%serror:%s %s\n", RED, RESET, message)
    env.error_count = env.error_count + 1
end

// === PASSES ===

forward func register_struct(env: @TypeEnv, ast: @AST, src: @char): void
forward func register_union(env: @TypeEnv, ast: @AST, src: @char): void
forward func register_func(env: @TypeEnv, ast: @AST, src: @char): void
forward func register_var(env: @TypeEnv, ast: @AST, src: @char): void
forward func register_params(env: @TypeEnv, ast: @AST, src: @char): void

forward func walk_statement_list(env: @TypeEnv, list: @AST, src: @char): void
forward func typecheck_statement(env: @TypeEnv, ast: @AST, src: @char): void

forward func lookup_struct(env: @TypeEnv, src: @char, start: int, length: int): @StructInfo
forward func lookup_field(env: @TypeEnv, info: @StructInfo, src: @char, start: int, length: int): @FieldInfo
forward func lookup_func_return_type_in_module(env: @TypeEnv, module_src: @char, call_src: @char, start: int, length: int, out: @TypeInfo): int

forward func resolve_expr_list(env: @TypeEnv, list: @AST, src: @char): void
forward func resolve_expr(env: @TypeEnv, expr: @AST, out: @TypeInfo, src: @char): int
forward func resolve_dot(env: @TypeEnv, expr: @AST, out: @TypeInfo, src: @char): int
forward func resolve_alias_call(env: @TypeEnv, expr: @AST, out: @TypeInfo, src: @char): int

forward func type_error(env: @TypeEnv, ast: @AST, message: @char): void

// Collection Pass

func typecheck_collect(env: @TypeEnv, ast: @AST, src: @char): void
    curr: @AST = ast
    while curr != null:
        if curr.kind == AST_STRUCT_DEF:
            register_struct(env, curr, src)

        else if curr.kind == AST_UNION_DEF:
            register_union(env, curr, src)

        else if curr.kind == AST_FUNC_DEF:
            register_func(env, curr, src)

        else if curr.kind == AST_PROP and curr.data._prop.decl != null:
            decl: @AST = curr.data._prop.decl

            if decl.kind == AST_FUNC_DEF:
                register_func(env, decl, src)

            else if decl.kind == AST_STRUCT_DEF:
                register_struct(env, decl, src)

            else if decl.kind == AST_UNION_DEF:
                register_struct(env, decl, src)
            end

        else if curr.kind == AST_VAR_DECL:
            register_var(env, curr, src)
        end
        curr = curr.next
    end
end

// Registrations

func register_struct(env: @TypeEnv, ast: @AST, src: @char): void
    if env.struct_count >= 1024:
        type_error(env, ast, "type environment struct table overflow")
        return
    end
    info: @StructInfo = env.structs + env.struct_count
    
    info.src = src
    info.name_start = ast.data._struct_def.name_start
    info.name_length = ast.data._struct_def.name_length
    info.field_count = 0

    field: @AST = ast.data._struct_def.fields
    while field != null:
        finfo: @FieldInfo = info.fields + info.field_count
        finfo.src = src
        finfo.name_start = field.data._struct_field.name_start
        finfo.name_length = field.data._struct_field.name_length
        copy_type(&finfo.type, &field.data._struct_field.type)

        info.field_count = info.field_count + 1
        field = field.next
    end

    env.struct_count = env.struct_count + 1
end

func register_union(env: @TypeEnv, ast: @AST, src: @char): void
    if env.struct_count >= 1024:
        type_error(env, ast, "type environment struct table overflow")
        return
    end
    info: @StructInfo = env.structs + env.struct_count

    info.src = src
    info.name_start = ast.data._union_def.name_start
    info.name_length = ast.data._union_def.name_length
    info.field_count = 0

    field: @AST = ast.data._union_def.fields
    while field != null:
        finfo: @FieldInfo = info.fields + info.field_count
        finfo.src = src
        finfo.name_start = field.data._struct_field.name_start
        finfo.name_length = field.data._struct_field.name_length
        copy_type(&finfo.type, &field.data._struct_field.type)

        info.field_count = info.field_count + 1
        field = field.next
    end

    env.struct_count = env.struct_count + 1
end

func register_func(env: @TypeEnv, ast: @AST, src: @char): void
    if env.func_count >= 1024:
        type_error(env, ast, "type environment struct table overflow")
        return
    end
    info: @FuncInfo = env.funcs + env.func_count

    info.src = src
    info.name_start = ast.data._func_def.name_start
    info.name_length = ast.data._func_def.name_length
    copy_type(&info.return_type, &ast.data._func_def.return_type)

    env.func_count = env.func_count + 1
end

func register_var(env: @TypeEnv, ast: @AST, src: @char): void
    if ast == null:
        return
    end

    if env.var_count >= 2048:
        type_error(env, ast, "type environment struct table overflow")
        return
    end
    info: @VarInfo = env.vars + env.var_count

    info.src = src
    info.name_start = ast.data._var_decl.name_start
    info.name_length = ast.data._var_decl.name_length
    copy_type(&info.type, &ast.data._var_decl.type)

    env.var_count = env.var_count + 1
end

func register_params(env: @TypeEnv, fnc: @AST, src: @char): void
    param: @AST = fnc.data._func_def.params

    while param != null:
        if env.var_count >= 2048:
            type_error(env, fnc, "type environment struct table overflow")
            return
        end
        info: @VarInfo = env.vars + env.var_count

        info.src = src
        info.name_start = param.data._func_params.name_start
        info.name_length = param.data._func_params.name_length
        copy_type(&info.type, &param.data._func_params.type)

        env.var_count = env.var_count + 1
        param = param.next
    end
end


// Resolve Types

forward func lookup_var_type(env: @TypeEnv, src: @char, start: int, length: int, out: @TypeInfo): int
forward func lookup_func_return_type(env: @TypeEnv, src: @char, start: int, length: int, out: @TypeInfo): int

func resolve_expr_list(env: @TypeEnv, list: @AST, src: @char): void
    curr: @AST = list
    while curr != null:
        tmp: @TypeInfo = new TypeInfo
        resolve_expr(env, curr, tmp, src)
        prune tmp
        curr = curr.next
    end
end

func resolve_expr(env: @TypeEnv, expr: @AST, out: @TypeInfo, src: @char): int
    if expr == null:
        return 0
    end

    if expr.kind == AST_VAR_REF:
        return lookup_var_type(env, src, expr.data._var_ref.name_start, expr.data._var_ref.name_length, out)
    
    else if expr.kind == AST_NEW:
        copy_type(out, &expr.data._new_alloc.type)
        out.pointer_depth = out.pointer_depth + 1
        return 1
    
    else if expr.kind == AST_DEREF:
        if !resolve_expr(env, expr.data._deref.operand, out, src):
            type_error(env, expr, "could not resolve object type for field access")
            // expr.data._dot_access.access_kind = ACCESS_UNKNOWN
            return 0
        end

        if out.pointer_depth <= 0:
            // error
            return 0
        end

        out.pointer_depth = out.pointer_depth - 1
        return 1

    else if expr.kind == AST_GET_ADDR:
        if !resolve_expr(env, expr.data._get_addr.operand, out, src):
            return 0
        end

        out.pointer_depth = out.pointer_depth + 1
        return 1

    else if expr.kind == AST_DOT_ACCESS:
        return resolve_dot(env, expr, out, src)

    else if expr.kind == AST_FUNC_CALL:
        resolve_expr_list(env, expr.data._func_call.args, src)
        return lookup_func_return_type(env, src, expr.data._func_call.name_start, expr.data._func_call.name_length, out)

    else if expr.kind == AST_ALIAS_CALL:
        resolve_expr_list(env, expr.data._alias_call.args, src)
        return resolve_alias_call(env, expr, out, src)

    else if expr.kind == AST_SUBSCRIPT:
        if !resolve_expr(env, expr.data._subscript.array, out, src):
            return 0
        end

        idx_type: @TypeInfo = new TypeInfo
        resolve_expr(env, expr.data._subscript.index, idx_type, src)
        prune idx_type

        out.array_size = 0
        out.arr_size_expr = null
        return 1

    else if expr.kind == AST_BINARY_OP:
        left_type: @TypeInfo = new TypeInfo
        right_type: @TypeInfo = new TypeInfo

        resolve_expr(env, expr.data._binary.left, left_type, src)
        resolve_expr(env, expr.data._binary.right, right_type, src)

        out.base = TOKEN_INT
        out.pointer_depth = 0
        out.array_size = 0
        out.arr_size_expr = null

        prune left_type
        prune right_type
        return 1

    else if expr.kind == AST_UNARY_NOT:
        operand_type: @TypeInfo = new TypeInfo
        resolve_expr(env, expr.data._unary.operand, operand_type, src)
        prune operand_type

        out.base = TOKEN_BOOL
        out.pointer_depth = 0
        out.array_size = 0
        out.arr_size_expr = null
        return 1

    else if expr.kind == AST_UNARY_NEG:
        operand_type: @TypeInfo = new TypeInfo
        if !resolve_expr(env, expr.data._unary.operand, operand_type, src):
            prune operand_type
            return 0
        end

        copy_type(out, operand_type)
        prune operand_type
        return 1

    else if expr.kind == AST_CAST:
        value_type: @TypeInfo = new TypeInfo
        resolve_expr(env, expr.data._cast.value, value_type, src)
        prune value_type

        copy_type(out, &expr.data._cast.type)
        return 1

    else if expr.kind == AST_SIZEOF:
        out.base = TOKEN_INT
        out.pointer_depth = 0
        out.array_size = 0
        out.arr_size_expr = null
        return 1

    else if expr.kind == AST_LITERAL:
        out.base = TOKEN_INT
        out.pointer_depth = 0
        out.array_size = 0
        out.arr_size_expr = null
        return 1

    else if expr.kind == AST_FLOAT_LIT:
        out.base = TOKEN_FLOAT
        out.pointer_depth = 0
        out.array_size = 0
        out.arr_size_expr = null
        return 1

    else if expr.kind == AST_CHAR_LIT:
        out.base = TOKEN_CHAR
        out.pointer_depth = 0
        out.array_size = 0
        out.arr_size_expr = null
        return 1

    else if expr.kind == AST_STRING_LIT:
        out.base = TOKEN_STRING
        out.pointer_depth = 0
        out.array_size = 0
        out.arr_size_expr = null
        return 1

    else if expr.kind == AST_NULL:
        out.base = TOKEN_VOID
        out.pointer_depth = 1
        out.array_size = 0
        out.arr_size_expr = null
        return 1
    end

    return 0
end

func resolve_dot(env: @TypeEnv, expr: @AST, out: @TypeInfo, src: @char): int
    object_type: @TypeInfo = new TypeInfo
    
    if !resolve_expr(env, expr.data._dot_access.object, object_type, src):
        type_error(env, expr, "could not resolve object type for field access")
        prune object_type
        return 0
    end

    if object_type.base != TOKEN_IDENTIFIER:
        // type_error(env, expr, "cannot access field on non-struct type")
        expr.data._dot_access.access_kind = ACCESS_UNKNOWN
        prune object_type
        return 0
    end

    if object_type.pointer_depth == 0:
        expr.data._dot_access.access_kind = ACCESS_DOT
    else if object_type.pointer_depth == 1:
        expr.data._dot_access.access_kind = ACCESS_ARROW
    else:
        type_error(env, expr, "cannot directly access field through multi-pointer type")
        prune object_type
        return 0
    end

    base_struct: @StructInfo = lookup_struct(env, object_type.name_src, object_type.name_start, object_type.name_length)
    if base_struct == null:
        // type_error(env, expr, "unknown struct type in field access")
        expr.data._dot_access.access_kind = ACCESS_UNKNOWN
        prune object_type
        return 0
    end

    field: @FieldInfo = lookup_field(env, base_struct, src, expr.data._dot_access.field_start, expr.data._dot_access.field_length)
    if field == null:
        // type_error(env, expr, "unknown field on struct")
        expr.data._dot_access.access_kind = ACCESS_UNKNOWN
        prune object_type
        return 0
    end

    copy_type(out, &field.type)
    copy_type(&expr.data._dot_access.resolved_type, &field.type)
    prune object_type
    return 1
end

func resolve_alias_call(env: @TypeEnv, expr: @AST, out: @TypeInfo, src: @char): int
    if current_type_module == null:
        return 0
    end

    imported: @Module = find_imported_module(active_type_modules, current_type_module, src, expr.data._alias_call.alias_start, expr.data._alias_call.alias_length)
    if imported == null:
        type_error(env, expr, "unknown module alias in function call")
        return 0
    end

    if !module_exports_func(imported, src, expr.data._alias_call.func_start, expr.data._alias_call.func_length):
        type_error(env, expr, "function is not exported by imported module")
        return 0
    end

    if !lookup_func_return_type_in_module(env, imported.src, src, expr.data._alias_call.func_start, expr.data._alias_call.func_length, out):
        type_error(env, expr, "could not resolve imported function return type")
        return 0
    end

    return 1
end

func typecheck_statement(env: @TypeEnv, ast: @AST, src: @char): void
    if ast.kind == AST_VAR_DECL:
        register_var(env, ast, src)
        if ast.data._var_decl.value != null:
            tmp: @TypeInfo = new TypeInfo
            resolve_expr(env, ast.data._var_decl.value, tmp, src)
            prune tmp
        end

    else if ast.kind == AST_VAR_ASS:
        tmp: @TypeInfo = new TypeInfo
        resolve_expr(env, ast.data._var_ass.value, tmp, src)
        prune tmp

    else if ast.kind == AST_DOT_ACCESS:
        tmp: @TypeInfo = new TypeInfo
        resolve_expr(env, ast, tmp, src)
        prune tmp
        if ast.data._dot_access.value != null:
            value_type: @TypeInfo = new TypeInfo
            resolve_expr(env, ast.data._dot_access.value, value_type, src)
            prune value_type
        end

    else if ast.kind == AST_IF:
        tmp: @TypeInfo = new TypeInfo
        resolve_expr(env, ast.data._if_condition.condition, tmp, src)
        walk_statement_list(env, ast.data._if_condition.body, src)
        walk_statement_list(env, ast.data._if_condition.else_branch, src)
        prune tmp

    else if ast.kind == AST_WHILE:
        tmp: @TypeInfo = new TypeInfo
        resolve_expr(env, ast.data._while_loop.condition, tmp, src)
        walk_statement_list(env, ast.data._while_loop.body, src)
        prune tmp

    else if ast.kind == AST_FOR:
        from_type: @TypeInfo = new TypeInfo
        to_type: @TypeInfo = new TypeInfo
        resolve_expr(env, ast.data._for_loop.from, from_type, src)
        resolve_expr(env, ast.data._for_loop.to, to_type, src)
        walk_statement_list(env, ast.data._for_loop.body, src)
        prune from_type
        prune to_type
    
    else if ast.kind == AST_FLOW_CONTROL:
        tmp: @TypeInfo = new TypeInfo
        resolve_expr(env, ast.data._flow_ctrl.value, tmp, src)
        prune tmp

    else if ast.kind == AST_PRINT:
        tmp: @TypeInfo = new TypeInfo
        resolve_expr(env, ast.data._print.value, tmp, src)
        prune tmp
    
    else if ast.kind == AST_FUNC_CALL or ast.kind == AST_ALIAS_CALL:
        tmp: @TypeInfo = new TypeInfo
        resolve_expr(env, ast, tmp, src)
        prune tmp
    end
end

func typecheck_ast(env: @TypeEnv, ast: @AST, src: @char): void
    curr: @AST = ast
    while curr != null:
        if curr.kind == AST_FUNC_DEF:
            saved_var_count: int = env.var_count
            register_params(env, curr, src)
            walk_statement_list(env, curr.data._func_def.body, src)
            env.var_count = saved_var_count

        else if curr.kind == AST_PROP and curr.data._prop.decl != null:
            decl: @AST = curr.data._prop.decl

            if decl.kind == AST_FUNC_DEF:
                saved_var_count: int = env.var_count
                register_params(env, decl, src)
                walk_statement_list(env, decl.data._func_def.body, src)
                env.var_count = saved_var_count
            end
        
        else if curr.kind == AST_VAR_DECL:
            if curr.data._var_decl.value != null:
                tmp: @TypeInfo = new TypeInfo
                resolve_expr(env, curr.data._var_decl.value, tmp, src)
                prune tmp
            end
        end
        curr = curr.next
    end
end


// Lookups

func lookup_struct(env: @TypeEnv, src: @char, start: int, length: int): @StructInfo
    for i in 0..env.struct_count:
        info: @StructInfo = env.structs + i
        if same_name(info.src, info.name_start, info.name_length, src, start, length):
            return info
        end
    end

    return null
end

func lookup_field(env: @TypeEnv, info: @StructInfo, src: @char, start: int, length: int): @FieldInfo
    for i in 0..info.field_count:
        field: @FieldInfo = info.fields + i
        if same_name(field.src, field.name_start, field.name_length, src, start, length):
            return field
        end
    end

    return null
end

func lookup_var_type(env: @TypeEnv, src: @char, start: int, length: int, out: @TypeInfo): int
    i: int = env.var_count - 1

    while i >= 0:
        info: @VarInfo = env.vars + i

        if same_name(info.src, info.name_start, info.name_length, src, start, length):
            copy_type(out, &info.type)
            return 1
        end

        i = i - 1
    end

    return 0
end

func lookup_func_return_type(env: @TypeEnv, src: @char, start: int, length: int, out: @TypeInfo): int
    for i in 0..env.func_count:
        info: @FuncInfo = env.funcs + i

        if same_name(info.src, info.name_start, info.name_length, src, start, length):
            copy_type(out, &info.return_type)
            return 1
        end
    end

    return 0
end

func lookup_func_return_type_in_module(env: @TypeEnv, module_src: @char, call_src: @char, start: int, length: int, out: @TypeInfo): int
    for i in 0..env.func_count:
        info: @FuncInfo = env.funcs + i

        if info.src == module_src and same_name(info.src, info.name_start, info.name_length, call_src, start, length):
            copy_type(out, &info.return_type)
            return 1
        end
    end

    return 0
end

// Walk statement

func walk_statement_list(env: @TypeEnv, list: @AST, src: @char): void
    curr: @AST = list

    while curr != null:
        typecheck_statement(env, curr, src)
        curr = curr.next
    end
end

// Entry Point

