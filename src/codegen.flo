import "src/lexer.flo" as lexer
import "src/parser.flo" as parser
import "src/file.flo" as file
import "src/module.flo" as module
import "src/stdlib/cstr.flo" as cstr

has_stdlib: int = 0
has_stdio: int = 0

// Currently processing (for circular detection)
active_modules: @ModuleSet
current_codegen_module: @Module

// === UTILITIES ===

func emit_string_runtime(out: @FILE): void
    fprintf(out, "#include <stdio.h>\n")

    fprintf(out, "typedef struct { char* data; int length; } flower_string;\n")

    fprintf(out, "static int flower_cstr_len(char* s) {\n")
    fprintf(out, "  int i = 0;\n")
    fprintf(out, "  if (s == NULL) return 0;\n")
    fprintf(out, "  while (s[i] != '\\0') i++;\n")
    fprintf(out, "  return i;\n")
    fprintf(out, "}\n")

    fprintf(out, "static flower_string flower_string_from_cstr(char* s) {\n")
    fprintf(out, "  flower_string out;\n")
    fprintf(out, "  out.data = s;\n")
    fprintf(out, "  out.length = (int)flower_cstr_len(s);\n")
    fprintf(out, "  return out;\n")
    fprintf(out, "}\n")

    fprintf(out, "static int flower_string_eq(flower_string a, flower_string b) {\n")
    fprintf(out, "  int i = 0;\n")
    fprintf(out, "  if (a.length != b.length) return 0;\n")
    fprintf(out, "  while (i < a.length) {\n")
    fprintf(out, "      if (a.data[i] != b.data[i]) return 0;\n")
    fprintf(out, "      i++;\n")
    fprintf(out, "  }\n")
    fprintf(out, "  return 1;\n")
    fprintf(out, "}\n")

    fprintf(out, "static void flower_print_string(flower_string s) {\n")
    fprintf(out, "  int i = 0;\n")
    fprintf(out, "  while (i < s.length) {\n")
    fprintf(out, "      putchar(s.data[i]);\n")
    fprintf(out, "      i++;\n")
    fprintf(out, "  }\n")
    fprintf(out, "}\n")
end

func emit_includes(mods: @ModuleSet, out: @FILE): void
    need_stdlib: int = 0
    need_stdio: int = 0
    need_string_h: int = 0
    need_ctype: int = 0
    need_unistd: int = 0

    for i in 0..mods.count:
        m: @Module = mods.modules + i

        if token_stream_contains(m.tokens, TOKEN_NULL) or token_stream_contains(m.tokens, TOKEN_NEW):
            has_stdlib = 1
        end

        if token_stream_contains(m.tokens, TOKEN_PRINT):
            has_stdio = 1
        end

        curr: @AST = m.ast
        while curr != null:
            if curr.kind == AST_IMPORT and curr.data._import.is_system:
                name: char[64]
                snprintf(name, sizeof(name), "%.*s", curr.data._import.path_length, m.src + curr.data._import.path_start)

                if cstr.eq(name, "stdio"):
                    need_stdio = 1
                else if cstr.eq(name, "stdlib"):
                    need_stdlib = 1
                else if cstr.eq(name, "string"):
                    need_string_h = 1
                else if cstr.eq(name, "ctype"):
                    need_ctype = 1
                else if cstr.eq(name, "unistd"):
                    need_unistd = 1
                end
            end
            curr = curr.next
        end
    end

    if need_stdlib:
        fprintf(out, "#include <stdlib.h>\n")
    end
    if need_stdio:
        fprintf(out, "#include <stdio.h>\n")
    end
    if need_string_h:
        fprintf(out, "#include <string.h>\n")
    end
    if need_ctype:
        fprintf(out, "#include <ctype.h>\n")
    end
    if need_unistd:
        fprintf(out, "#include <unistd.h>\n")
    end
end


func token_to_string(kind: int): @char
    if kind == TOKEN_INT:
        return "int"

    else if kind == TOKEN_BOOL:
        return "int"

    else if kind == TOKEN_FLOAT:
        return "float"

    else if kind == TOKEN_DOUBLE:
        return "double"

    else if kind == TOKEN_CHAR:
        return "char"

    else if kind == TOKEN_STRING:
        return "string"

    else if kind == TOKEN_VOID:
        return "void"

        // === Keywords ===
    else if kind == TOKEN_RETURN:
        return "return"

    else if kind == TOKEN_WHILE:
        return "while"

    else if kind == TOKEN_IF:
        return "if"

    else if kind == TOKEN_ELSE:
        return "else"

    else if kind == TOKEN_END:
        return "}"

    else if kind == TOKEN_OR:
        return " || "

    else if kind == TOKEN_AND:
        return " && "

        // === Operators ===
    else if kind == TOKEN_DOT:
        return "."

    else if kind == TOKEN_PLUS:
        return "+"

    else if kind == TOKEN_MINUS:
        return "-"

    else if kind == TOKEN_STAR:
        return "*"

    else if kind == TOKEN_SLASH:
        return "/"

    else if kind == TOKEN_CARET:
        return "^"

    else if kind == TOKEN_AT:
        return "@"

    else if kind == TOKEN_AMPERSAND:
        return "&"

    else if kind == TOKEN_ASSIGN:
        return "="

    else if kind == TOKEN_LT:
        return "<"

    else if kind == TOKEN_GT:
        return ">"

    else if kind == TOKEN_GEQ:
        return ">="

    else if kind == TOKEN_LEQ:
        return "<="

    else if kind == TOKEN_NEQ:
        return "!="

    else if kind == TOKEN_COMP:
        return "=="

        // === Punctuation ===
    else if kind == TOKEN_LPAREN:
        return "("

    else if kind == TOKEN_RPAREN:
        return ")"

    else if kind == TOKEN_LBRACE:
        return "{"

    else if kind == TOKEN_RBRACE:
        return "}"

    else if kind == TOKEN_COLON:
        return ":"

    else if kind == TOKEN_COMMA:
        return ","

    else if kind == TOKEN_SEMI:
        return ""

    else if kind == TOKEN_NEWLINE:
        return "\n"

    else:
        return "ERROR"

    end
end

func copy_typeinfo(dst: @TypeInfo, src_type: @TypeInfo): void
    dst.base = src_type.base
    dst.pointer_depth = src_type.pointer_depth
    dst.array_size = src_type.array_size
    dst.arr_size_expr = src_type.arr_size_expr
    dst.is_nullable = src_type.is_nullable
    dst.name_start = src_type.name_start
    dst.name_length = src_type.name_length
    dst.name_src = src_type.name_src
    dst.is_union = src_type.is_union
    dst.union_count = src_type.union_count

    i: int = 0
    while i < src_type.union_count:
        dst.union_members[i].base = src_type.union_members[i].base
        dst.union_members[i].pointer_depth = src_type.union_members[i].pointer_depth
        dst.union_members[i].array_size = src_type.union_members[i].array_size
        dst.union_members[i].arr_size_expr = src_type.union_members[i].arr_size_expr
        dst.union_members[i].name_start = src_type.union_members[i].name_start
        dst.union_members[i].name_length = src_type.union_members[i].name_length
        dst.union_members[i].name_src = src_type.union_members[i].name_src
        dst.union_members[i].is_nullable = src_type.union_members[i].is_nullable
        i = i + 1
    end
end

func find_type_alias(src: @char, start: int, length: int, out: @TypeInfo): bool
    for i in 0..active_modules.count:
        m: @Module = active_modules.modules + i

        if m.src != src:
            continue
        end

        curr: @AST = m.ast
        while curr != null:
            decl: @AST = curr

            if curr.kind == AST_PROP and curr.data._prop.decl != null:
                decl = curr.data._prop.decl
            end

            if decl.kind == AST_TYPE_ALIAS:
                if decl.data._type_alias.name_length == length and cstr.eq_n(src + decl.data._type_alias.name_start, src + start, length):
                    copy_typeinfo(out, &decl.data._type_alias.target)
                    return true
                end
            end

            curr = curr.next
        end
    end

    return false
end

func canonicalize_codegen_type(typeInfo: @TypeInfo, depth: int): bool
    if typeInfo.base != TOKEN_IDENTIFIER:
        return true
    end

    if depth >= 32:
        return false
    end

    target: @TypeInfo = new TypeInfo
    if not find_type_alias(typeInfo.name_src, typeInfo.name_start, typeInfo.name_length, target):
        prune target
        return true
    end

    outer_pointer_depth: int = typeInfo.pointer_depth
    outer_array_size: int = typeInfo.array_size
    outer_array_expr: @AST = typeInfo.arr_size_expr
    outer_nullable: bool = typeInfo.is_nullable

    if not canonicalize_codegen_type(target, depth + 1):
        prune target
        return false
    end

    if target.array_size != 0 or target.arr_size_expr != null:
        prune target
        return false
    end

    copy_typeinfo(typeInfo, target)

    if outer_nullable:
        typeInfo.is_nullable = true
    end

    typeInfo.pointer_depth = typeInfo.pointer_depth + outer_pointer_depth

    if outer_array_size != 0 or outer_array_expr != null:
        typeInfo.array_size = outer_array_size
        typeInfo.arr_size_expr = outer_array_expr
    end

    prune target
    return true
end

func typeinfo_to_string(typeInfo: @TypeInfo, out: @FILE, src: @char): void
    resolved: @TypeInfo = new TypeInfo
    copy_typeinfo(resolved, typeInfo)
    canonicalize_codegen_type(resolved, 0)
    
    if resolved.base == TOKEN_IDENTIFIER:
        name_src: @char = resolved.name_src
        if name_src == null:
            name_src = src
        end
        fprintf(out, "%.*s", resolved.name_length, name_src + resolved.name_start)

    else if resolved.base == TOKEN_STRING:
        fprintf(out, "flower_string")

    else:
        fprintf(out, "%s", token_to_string(resolved.base))
    end

    i: int = 0
    while i < resolved.pointer_depth:
        i = i + 1
        fprintf(out, "*")
    end

    prune resolved
end



// === FORWARDS ===

forward func gen_expr(ast: @AST, out: @FILE, src: @char): void
forward func gen_statement(ast: @AST, out: @FILE, src: @char): void


// === CONDITIONALS ===

func gen_if(ast: @AST, out: @FILE, src: @char, is_else_if: int): void
    if is_else_if:
        if ast.data._if_condition.condition == null:
            fprintf(out, "else {\n")
        else:
            fprintf(out, "else if (")
            gen_expr(ast.data._if_condition.condition, out, src)
            fprintf(out, ") {\n")
        end
    else:
        fprintf(out, "if (")
        gen_expr(ast.data._if_condition.condition, out, src)
        fprintf(out, ") {\n")
    end

    statement: @AST = ast.data._if_condition.body
    while statement != null:
        gen_statement(statement, out, src)
        statement = statement.next
    end
    fprintf(out, "}\n")

    if ast.data._if_condition.else_branch != null:
        gen_if(ast.data._if_condition.else_branch, out, src, 1)
    end
end

func gen_while(ast: @AST, out: @FILE, src: @char): void
    fprintf(out, "while (")
    gen_expr(ast.data._while_loop.condition, out, src)
    fprintf(out, ") {\n")
    
    statement: @AST = ast.data._while_loop.body
    while statement != null:
        gen_statement(statement, out, src)
        statement = statement.next
    end
    fprintf(out, "}\n")
end

func gen_for(ast: @AST, out: @FILE, src: @char): void
    desc_op: @char
    asc_op: @char
    if ast.data._for_loop.inclusive:
        desc_op = ">="
        asc_op = "<="
    else:
        desc_op = ">"
        asc_op = "<"
    end

    add_op: @char = "++"
    sub_op: @char = "--"

    from: @AST = ast.data._for_loop.from
    to: @AST = ast.data._for_loop.to
    if from.kind == AST_LITERAL and to.kind == AST_LITERAL:
        reverse: int
        if from.value > to.value:
            reverse = 1
        else:
            reverse = 0
        end

        op: @char
        math_op: @char
        if reverse:
            op = desc_op
            math_op = sub_op
        else:
            op = asc_op
            math_op = add_op
        end

        fprintf(out, "for (int %.*s = ", ast.data._for_loop.var_length, src + ast.data._for_loop.var_start)
        gen_expr(ast.data._for_loop.from, out, src)
        fprintf(out, "; %.*s %s ", ast.data._for_loop.var_length, src + ast.data._for_loop.var_start, op)
        gen_expr(ast.data._for_loop.to, out, src)

        fprintf(out, "; %.*s%s) {\n", ast.data._for_loop.var_length, src + ast.data._for_loop.var_start, math_op)
    else:
        fprintf(out, "for (int %.*s = ", ast.data._for_loop.var_length, src + ast.data._for_loop.var_start)
        gen_expr(ast.data._for_loop.from, out, src)

        fprintf(out, "; ((")
        gen_expr(ast.data._for_loop.from, out, src)
        fprintf(out, ") > (")
        gen_expr(ast.data._for_loop.to, out, src)
        fprintf(out, ")) ? %.*s %s (", ast.data._for_loop.var_length, src + ast.data._for_loop.var_start, desc_op)
        gen_expr(ast.data._for_loop.to, out, src)
        fprintf(out, ") : %.*s %s (", ast.data._for_loop.var_length, src + ast.data._for_loop.var_start, asc_op)
        gen_expr(ast.data._for_loop.to, out, src)

        fprintf(out, "); ((")
        gen_expr(ast.data._for_loop.from, out, src)
        fprintf(out, ") > (")
        gen_expr(ast.data._for_loop.to, out, src)
        fprintf(out, ")) ? %.*s-- : %.*s++) {\n", ast.data._for_loop.var_length, src + ast.data._for_loop.var_start, ast.data._for_loop.var_length, src + ast.data._for_loop.var_start)
    end

    statement: @AST = ast.data._for_loop.body
    while statement != null:
        gen_statement(statement, out, src)
        statement = statement.next
    end
    fprintf(out, "}\n")
end



// === CONTROL FLOW ===

func gen_return(ast: @AST, out: @FILE, src: @char): void
    // Emit: return n
    if ast.data._flow_ctrl.value == null:
        fprintf(out, "return;")
    else:
        fprintf(out, "return ")
        gen_expr(ast.data._flow_ctrl.value, out, src)
        fprintf(out, ";\n")
    end
end

func gen_continue(ast: @AST, out: @FILE, src: @char): void
    // Emit: continue
    fprintf(out, "continue;\n")
end

func gen_break(ast: @AST, out: @FILE, src: @char): void
    // Emit: break
    fprintf(out, "break;\n")
end



// === STRUCTS & UNIONS ===

struct defined_struct {
    name: @char,
    length: int
}
defined_structs: defined_struct[256]
defined_count: int = 0

func gen_struct(ast: @AST, out: @FILE, src: @char): void
    for i in 0..defined_count:
        if defined_structs[i].length == ast.data._struct_def.name_length and cstr.eq_n(defined_structs[i].name, src + ast.data._struct_def.name_start, ast.data._struct_def.name_length):
            return
        end
    end
    fprintf(out, "\n\ntypedef struct %.*s {\n", ast.data._struct_def.name_length, src + ast.data._struct_def.name_start)
    field: @AST = ast.data._struct_def.fields
    while field != null:
        typeinfo_to_string(&field.data._struct_field.typeInfo, out, src)
        fprintf(out, " %.*s", field.data._struct_field.name_length, src + field.data._struct_field.name_start)

        if field.data._struct_field.typeInfo.array_size == -1:
            fprintf(out, "[]")
        else if field.data._struct_field.typeInfo.array_size > 0:
            fprintf(out, "[%d]", field.data._struct_field.typeInfo.array_size)
        else if field.data._struct_field.typeInfo.arr_size_expr != null:
            fprintf(out, "[")
            gen_expr(field.data._struct_field.typeInfo.arr_size_expr, out, src)
            fprintf(out, "]")
        end

        fprintf(out, ";\n")
        field = field.next
    end
    fprintf(out, "} %.*s;\n", ast.data._struct_def.name_length, src + ast.data._struct_def.name_start)

    defined_structs[defined_count].name = cstr.dup_n(src + ast.data._struct_def.name_start, ast.data._struct_def.name_length)
    defined_structs[defined_count].length = ast.data._struct_def.name_length
    defined_count = defined_count + 1
end

struct defined_union {
    name: @char,
    length: int
}
defined_unions: defined_union[256]
defined_union_count: int = 0

func gen_union(ast: @AST, out: @FILE, src: @char): void
    for i in 0..defined_union_count:
        if defined_unions[i].length == ast.data._union_def.name_length and cstr.eq_n(defined_unions[i].name, src + ast.data._union_def.name_start, ast.data._union_def.name_length):
            return
        end
    end
    fprintf(out, "\n\ntypedef union %.*s {\n", ast.data._union_def.name_length, src + ast.data._union_def.name_start)
    field: @AST = ast.data._union_def.fields
    while field != null:
        typeinfo_to_string(&field.data._struct_field.typeInfo, out, src)
        fprintf(out, " %.*s", field.data._struct_field.name_length, src + field.data._union_def.name_start)

        if field.data._struct_field.typeInfo.array_size == -1:
            fprintf(out, "[]")
        else if field.data._struct_field.typeInfo.array_size > 0:
            fprintf(out, "[%d]", field.data._struct_field.typeInfo.array_size)
        else if field.data._struct_field.typeInfo.arr_size_expr != null:
            fprintf(out, "[")
            gen_expr(field.data._struct_field.typeInfo.arr_size_expr, out, src)
            fprintf(out, "]")
        end

        fprintf(out, ";\n")
        field = field.next
    end
    fprintf(out, "} %.*s;\n", ast.data._union_def.name_length, src + ast.data._union_def.name_start)

    defined_unions[defined_union_count].name = cstr.dup_n(src + ast.data._union_def.name_start, ast.data._union_def.name_length)
    defined_unions[defined_union_count].length = ast.data._union_def.name_length
    defined_union_count = defined_union_count + 1
end



// === FUNCTIONS ===

// Track emitted alias+file combos to prevent duplicates

struct EmittedImport {
    path: @char
    alias: @char
}

emitted_imports: EmittedImport[256]
emitted_count: int = 0

forward func emit_lowered_func_name(mod: @Module, out: @FILE, src: @char, start: int, length: int): void
forward func resolve_called_function_module(src: @char, start: int, length: int): @Module


func gen_param(param: @AST, out: @FILE, src: @char): void
    // Emit: int v,
    typeinfo_to_string(&param.data._func_params.typeInfo, out, src)
    fprintf(out, " %.*s", param.data._func_params.name_length, src + param.data._func_params.name_start)

    if param.data._func_params.typeInfo.array_size == -1:
        fprintf(out, "[]")
    else if param.data._func_params.typeInfo.array_size != 0:
        fprintf(out, "[%d]", param.data._func_params.typeInfo.array_size)
    else if param.data._func_params.typeInfo.arr_size_expr != null:
        fprintf(out, "[")
        gen_expr(param.data._func_params.typeInfo.arr_size_expr, out, src)
        fprintf(out, "]")
    end
end

func gen_func_def(ast: @AST, out: @FILE, src: @char): void
    // Emit: int fib(
    fprintf(out, "\n\n")
    typeinfo_to_string(&ast.data._func_def.return_type, out, src)
    fprintf(out, " ")
    emit_lowered_func_name(current_codegen_module, out, src, ast.data._func_def.name_start, ast.data._func_def.name_length)
    fprintf(out, "(")
    
    // Emit: params
    param: @AST = ast.data._func_def.params
    while param != null:
        gen_param(param, out, src)
        if param.next != null:
            fprintf(out, ", ")
        end
        param = param.next
    end
    fprintf(out, ") {\n")

    // Emit: body
    statement: @AST = ast.data._func_def.body
    while statement != null:
        gen_statement(statement, out, src)
        statement = statement.next
    end
    fprintf(out, "}\n")
end

func emit_lowered_func_name(mod: @Module, out: @FILE, src: @char, start: int, length: int): void
    if mod != null:
        root: @Module = active_modules.modules + 0

        if cstr.eq(mod.path, root.path) and length == 4 and cstr.eq_n(src + start, "main", 4):
            fprintf(out, "main")
            return
        end

        fprintf(out, "%s_%.*s", mod.symbol_prefix, length, src + start)
        return
    end

    fprintf(out, "%.*s", length, src + start)
end

func resolve_called_function_module(src: @char, start: int, length: int): @Module
    if current_codegen_module != null and module_defines_func(current_codegen_module, src, start, length):
        return current_codegen_module
    end

    return find_function_module(active_modules, src, start, length)
end

func gen_func_def_aliased(ast: @AST, out: @FILE, src: @char, alias: @char, alias_len: int): void
    gen_func_def(ast, out, src)
end

func gen_func_call(ast: @AST, out: @FILE, src: @char): void
    target_mod: @Module = resolve_called_function_module(src, ast.data._func_call.name_start, ast.data._func_call.name_length)

    if target_mod != null:
        emit_lowered_func_name(target_mod, out, src, ast.data._func_call.name_start, ast.data._func_call.name_length)
    else:
        fprintf(out, "%.*s", ast.data._func_call.name_length, src + ast.data._func_call.name_start)
    end

    fprintf(out, "(")

    arg: @AST = ast.data._func_call.args
    while arg != null:
        gen_expr(arg, out, src)
        if arg.next != null:
            fprintf(out, ", ")
        end
        arg = arg.next
    end
    fprintf(out, ")")
end



// === VARIABLES ===

func gen_var_decl(ast: @AST, out: @FILE, src: @char): void
    typeinfo_to_string(&ast.data._var_decl.typeInfo, out, src)
    fprintf(out, " %.*s", ast.data._var_decl.name_length, src + ast.data._var_decl.name_start)
    if ast.data._var_decl.typeInfo.array_size == -1:
        fprintf(out, "[]")
    else if ast.data._var_decl.typeInfo.array_size != 0:
        fprintf(out, "[%d]", ast.data._var_decl.typeInfo.array_size)
    else if ast.data._var_decl.typeInfo.arr_size_expr != null:
        fprintf(out, "[")
        gen_expr(ast.data._var_decl.typeInfo.arr_size_expr, out, src)
        fprintf(out, "]")
    end
    if ast.data._var_decl.value != null:
        fprintf(out, " = ")
        gen_expr(ast.data._var_decl.value, out, src)
    end
    fprintf(out, ";\n")
end

func gen_var_ass(ast: @AST, out: @FILE, src: @char): void
    fprintf(out, "%.*s = ", ast.data._var_ass.name_length, src + ast.data._var_ass.name_start)
    gen_expr(ast.data._var_ass.value, out, src)
    fprintf(out, ";\n")
end



// === IMPORT ===

func gen_forward(ast: @AST, out: @FILE, src: @char): void
    if ast.data._forward.is_func:
        typeinfo_to_string(&ast.data._forward.return_type, out, src)
        fprintf(out, " ")
        emit_lowered_func_name(current_codegen_module, out, src, ast.data._forward.name_start, ast.data._forward.name_length)
        fprintf(out, "(")

        param: @AST = ast.data._forward.params
        while param != null:
            gen_param(param, out, src)
            if param.next != null:
                fprintf(out, ", ")
            end
            param = param.next
        end
        fprintf(out, ");\n")
    else:
        fprintf(out, "typedef struct %.*s %.*s;\n", ast.data._forward.name_length, src + ast.data._forward.name_start, ast.data._forward.name_length, src + ast.data._forward.name_start)
    end
end

// // Import Cache
// struct ImportCache {
//     path: @char,
//     ast: @AST,
//     src: @char
// }

// import_cache: ImportCache[64]
// cache_count: int = 0

forward func gen_import(ast: @AST, out: @FILE, src: @char): void
forward func emit_module(mod: @Module, out: @FILE, alias: @char, alias_len: int, has_alias: int): void

func emit_module(mod: @Module, out: @FILE, alias: @char, alias_len: int, has_alias: int): void
    original: @char = current_file
    current_file = mod.path

    original_module: @Module = current_codegen_module
    current_codegen_module = mod

    // Emit imported file
    curr: @AST = mod.ast
    while curr != null:
        if curr.kind == AST_IMPORT:
            gen_import(curr, out, mod.src)
        else if curr.kind == AST_STRUCT_DEF:
            gen_struct(curr, out, mod.src)
        else if curr.kind == AST_UNION_DEF:
            gen_union(curr, out, mod.src)
        else if curr.kind == AST_PROP:
            decl: @AST = curr.data._prop.decl

            if decl.kind == AST_FUNC_DEF:
                gen_func_def(decl, out, mod.src)

            else if decl.kind == AST_STRUCT_DEF:
                gen_struct(decl, out, mod.src)

            else if decl.kind == AST_UNION_DEF:
                gen_union(decl, out, mod.src)
            end

        else if curr.kind == AST_FORWARD:
            gen_forward(curr, out, mod.src)
        else if curr.kind == AST_FUNC_DEF:
            gen_func_def(curr, out, mod.src)
        else if curr.kind == AST_VAR_DECL:
            gen_var_decl(curr, out, mod.src)
        end
        curr = curr.next
    end

    current_file = original
    current_codegen_module = original_module
end

func gen_import(ast: @AST, out: @FILE, src: @char): void
    if ast.data._import.is_system:
        return
    end

    raw_path: char[256]
    snprintf(raw_path, sizeof(raw_path), "%.*s", ast.data._import.path_length - 2, src + ast.data._import.path_start + 1)
    
    path: @char = resolve_path(current_file, raw_path)

    alias: char[64]
    alias[0] = '\0'

    if ast.data._import.has_alias:
        snprintf(alias, sizeof(alias), "%.*s", ast.data._import.alias_length, src + ast.data._import.alias_start)
    end

    // Check if this exact path+alias combo already emitted
    for i in 0..emitted_count:
        if cstr.eq(emitted_imports[i].path, path):
            prune path
            return
        end
    end

    // Module handling
    imported: @Module = find_module(active_modules, path)
    if imported == null:
        printf("%sCould not find loaded import module: %s%s", RED, RESET, path)
        prune path
        return
    end

    // // Mark as in progress
    // in_progress[in_progress_count] = cstr.dup(path)
    // in_progress_count = in_progress_count + 1

    // // Check cache for already-parsed AST
    // imported_ast: @AST = null
    // imported_src: @char = null
    // cached_ts: @TokenStream = null

    // for i in 0..cache_count:
    //     if cstr.eq(import_cache[i].path, path):
    //         imported_ast = import_cache[i].ast
    //         imported_src = import_cache[i].src
    //         break
    //     end
    // end
    
    // // If not cached, read and parse
    // if imported_ast == null:
    //     imported_src = file.read_file(path)
    //     if not imported_src:
    //         printf("%sCould not import file: %s\nfrom file:%s\nwith root: %s%s\n", RED, path, original, project_root, RESET)
    //         exit(1)
    //     end

    //     set_current_file(path)

    //     printf("Importing: %s\n", path)
    //     ts: @TokenStream = new TokenStream
    //     lexer.init_token_stream(ts)
    //     lexer.lex(ts, imported_src)
        
    //     if cstr.eq(path, "PATH") == 0:
    //         lexer.print_all_tokens(ts, imported_src)
    //     end

    //     if not has_stdlib and (token_stream_contains(ts, TOKEN_NEW) or token_stream_contains(ts, TOKEN_NULL)):
    //         fprintf(out, "#include <stdlib.h>\n")
    //         has_stdlib = 1
    //     end
    //     if not has_stdio and token_stream_contains(ts, TOKEN_PRINT):
    //         fprintf(out, "#include <stdio.h>\n")
    //         has_stdio = 1
    //     end

    //     p: Parser
    //     parser.init_parser(&p, ts, imported_src, path)
    //     imported_ast = parser.parse(&p)

    //     // Store in cache
    //     import_cache[cache_count].path = cstr.dup(path)
    //     import_cache[cache_count].ast = imported_ast
    //     import_cache[cache_count].src = imported_src
    //     cache_count = cache_count + 1
    // end

    // Record this path+alias as emitted
    emitted_imports[emitted_count].path = cstr.dup(path)
    emitted_imports[emitted_count].alias = cstr.dup(alias)
    emitted_count = emitted_count + 1

    emit_module(imported, out, "", 0, 0)

    // // Emit functions
    // curr: @AST = imported_ast
    // while curr != null:
    //     if curr.kind == AST_IMPORT:
    //         gen_import(curr, out, imported_src)
    //     else if curr.kind == AST_STRUCT_DEF:
    //         gen_struct(curr, out, imported_src)
    //     else if curr.kind == AST_UNION_DEF:
    //         gen_union(curr, out, imported_src)
    //     else if curr.kind == AST_PROP:
    //         if ast.data._import.has_alias:
    //             gen_func_def_aliased(curr.data._prop.func, out, imported_src, alias, strlen(alias))
    //         else:
    //             gen_func_def(curr.data._prop.func, out, imported_src)
    //         end
    //     else if curr.kind == AST_FORWARD:
    //         gen_forward(curr, out, imported_src)
    //     else if curr.kind == AST_FUNC_DEF:
    //         gen_func_def(curr, out, imported_src)
    //     else if curr.kind == AST_VAR_DECL:
    //         gen_var_decl(curr, out, imported_src)
