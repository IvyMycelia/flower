end



// === EXECUTIVE ===

func gen_expr(ast: @AST, out: @FILE, src: @char): void
    if ast.kind == AST_VAR_REF:
        fprintf(out, "%.*s", ast.data._var_ref.name_length, src + ast.data._var_ref.name_start)

    else if ast.kind == AST_LITERAL:
        fprintf(out, "%d", ast.value)

    else if ast.kind == AST_FLOAT_LIT:
        fprintf(out, "%.*s", ast.data._float_lit.length, src + ast.data._float_lit.start)

    else if ast.kind == AST_BOOL_LIT:
        fprintf(out, "%d", ast.data._bool_lit.value)
        
    else if ast.kind == AST_BOOL_LIT:
        fprintf(out, "%d", ast.data._bool_lit.value)

    else if ast.kind == AST_NULL:
        fprintf(out, "NULL")

    else if ast.kind == AST_TYPE_TEST:
        if ast.data._type_test.lower_kind == TYPE_TEST_NONNULL:
            fprintf(out, "(")
            gen_expr(ast.data._type_test.value, out, src)
            fprintf(out, " != NULL)")
        else:
            fprintf(out, "1")
        end
        
    else if ast.kind == AST_BINARY_OP: 
        if ast.data._binary.is_string_compare:
            if ast.data._binary.op == TOKEN_NEQ:
                fprintf(out, "(!flower_string_eq(")
            else:
                fprintf(out, "flower_string_eq(")
            end

            gen_expr(ast.data._binary.left, out, src)
            fprintf(out, ", ")
            gen_expr(ast.data._binary.right, out, src)

            if ast.data._binary.op == TOKEN_NEQ:
                fprintf(out, "))")
            else:
                fprintf(out, ")")
            end
        else:
            gen_expr(ast.data._binary.left, out, src)
            fprintf(out, " %s ", token_to_string(ast.data._binary.op))
            gen_expr(ast.data._binary.right, out, src)
        end
        
    else if ast.kind == AST_FUNC_CALL: 
        gen_func_call(ast, out, src)
        
    else if ast.kind == AST_STRING_LIT:
        // PROPER STRING LOWERING — UNNUSED UNTIL COMPILER IS UPDATED
        // fprintf(out, "flowe_string_from_cst(")
        // fprintf(out, "%.*s", ast.data._string.str_length, src + ast.data._string.str_start)
        // fprintf(out, ")")

        // fprintf(out, "%.*s", ast.data._string.str_length, src + ast.data._string.str_start)

        if ast.data._string.lower_kind == STRING_LOWER_CSTR:
            fprintf(out, "%.*s", ast.data._string.str_length, src + ast.data._string.str_start)
        else:
            fprintf(out, "((flower_string){ ")
            fprintf(out, "%.*s", ast.data._string.str_length, src + ast.data._string.str_start)
            fprintf(out, ", (int)(sizeof(")
            fprintf(out, "%.*s", ast.data._string.str_length, src + ast.data._string.str_start)
            fprintf(out, ") - 1) })")
        end
        
    else if ast.kind == AST_ARRAY_LIT:
        fprintf(out, "{")
        elem: @AST = ast.data._array.elements
        while elem != null:
            gen_expr(elem, out, src)
            if elem.next != null:
                fprintf(out, ", ")
            end
            elem = elem.next
        end
        fprintf(out, "}")
        
    else if ast.kind == AST_STRUCT_LIT:
        fprintf(out, "{")
        struct_elem: @AST = ast.data._struct_lit.elements
        while struct_elem != null:
            gen_expr(struct_elem, out, src)
            if struct_elem.next != null:
                fprintf(out, ", ")
                struct_elem = struct_elem.next
            end
        end
        fprintf(out, "}")
        
    else if ast.kind == AST_CAST:
        if ast.data._cast.typeInfo.base == TOKEN_CHAR and ast.data._cast.typeInfo.pointer_depth == 1 and ast.data._cast.typeInfo.array_size == 0 and ast.data._cast.value_type.base == TOKEN_STRING and ast.data._cast.value_type.pointer_depth == 0 and ast.data._cast.value_type.array_size == 0:
            fprintf(out, "(")
            gen_expr(ast.data._cast.value, out, src)
            fprintf(out, ").data")

        else if ast.data._cast.typeInfo.base == TOKEN_STRING and ast.data._cast.typeInfo.pointer_depth == 0 and ast.data._cast.typeInfo.array_size == 0 and ast.data._cast.value_type.base == TOKEN_CHAR and ast.data._cast.value_type.pointer_depth == 1 and ast.data._cast.value_type.array_size == 0:
            fprintf(out, "flower_string_from_cstr(")
            gen_expr(ast.data._cast.value, out, src)
            fprintf(out, ")")

        else if ast.data._cast.typeInfo.base == TOKEN_BOOL and ast.data._cast.typeInfo.pointer_depth == 0 and ast.data._cast.typeInfo.array_size == 0:
            fprintf(out, "((")
            gen_expr(ast.data._cast.value, out, src)
            fprintf(out, ") != 0")

        else:
            fprintf(out, "(")
            typeinfo_to_string(&ast.data._cast.typeInfo, out, src)
            fprintf(out, ")(")
            gen_expr(ast.data._cast.value, out, src)
            fprintf(out, ")")
        end
        
    else if ast.kind == AST_DOT_ACCESS:
        object: @AST = ast.data._dot_access.object
        gen_expr(object, out, src)
        obj_kind: int = ast.data._dot_access.access_kind
        if obj_kind == ACCESS_ARROW:
            fprintf(out, "->%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
        else if obj_kind == ACCESS_DOT:
            fprintf(out, ".%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
        else:
            obj_kind: int = object.kind
            if obj_kind == AST_DOT_ACCESS:
                if object.data._dot_access.resolved_type.pointer_depth > 0:
                    fprintf(out, "->%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
                else:
                    fprintf(out, ".%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
                end

            else if obj_kind == AST_SUBSCRIPT:
                fprintf(out, ".%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)

            else:
                fprintf(out, "->%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
            end
        end
        
    else if ast.kind == AST_NEW:
        fprintf(out, "malloc(sizeof(")
        typeinfo_to_string(&ast.data._new_alloc.typeInfo, out, src)
        fprintf(out, ")")
            
        if ast.data._new_alloc.typeInfo.arr_size_expr != null:
            fprintf(out, " * (")
            gen_expr(ast.data._new_alloc.typeInfo.arr_size_expr, out, src)
            fprintf(out, ")")
        else if ast.data._new_alloc.typeInfo.array_size > 0:
            fprintf(out, " * %d", ast.data._new_alloc.typeInfo.array_size)
        end
        fprintf(out, ")")

    else if ast.kind == AST_ALIAS_CALL:
        imported: @Module = find_imported_module(active_modules, current_codegen_module, src, ast.data._alias_call.alias_start, ast.data._alias_call.alias_length)

        if imported != null:
            emit_lowered_func_name(imported, out, src, ast.data._alias_call.func_start, ast.data._alias_call.func_length)
        else:
            fprintf(out, "%.*s_%.*s", ast.data._alias_call.alias_length, src + ast.data._alias_call.alias_start, ast.data._alias_call.func_length, src + ast.data._alias_call.func_start)
        end

        fprintf(out, "(")

        arg: @AST = ast.data._alias_call.args
        while arg != null:
            gen_expr(arg, out, src)
            if arg.next != null:
                fprintf(out, ", ")
            end
            arg = arg.next
        end
        fprintf(out, ")")
        
    else if ast.kind == AST_UNARY_NOT:
        fprintf(out, "!(")
        gen_expr(ast.data._unary.operand, out, src)
        fprintf(out, ")")
                
    else if ast.kind == AST_UNARY_NEG:
        fprintf(out, "-")
        gen_expr(ast.data._unary.operand, out, src)
        
    else if ast.kind == AST_DEREF:
        fprintf(out, "*(")
        gen_expr(ast.data._deref.operand, out, src)
        fprintf(out, ")")
        
    else if ast.kind == AST_GET_ADDR:
        fprintf(out, "&(")
        gen_expr(ast.data._get_addr.operand, out, src)
        fprintf(out, ")")
        
    else if ast.kind == AST_SIZEOF:
        fprintf(out, "sizeof(")
        typeinfo_to_string(&ast.data._size_of.typeInfo, out, src)
        fprintf(out, ")")
        
    else if ast.kind == AST_CHAR_LIT:
        fprintf(out, "%.*s", ast.data._char_lit.length, src + ast.data._char_lit.start)
        
    else if ast.kind == AST_SUBSCRIPT:
        gen_expr(ast.data._subscript.array, out, src)
        if ast.data._subscript.is_string:
            fprintf(out, ".data[")
        else:
            fprintf(out, "[")
        end
        gen_expr(ast.data._subscript.index, out, src)
        fprintf(out, "]")

    else:
        printf("gen_expr received node addr: %p, kind: %d\n", ast, ast.kind)
        exit(1)
    end
end

func gen_statement(ast: @AST, out: @FILE, src: @char): void
    if ast.kind == AST_VAR_DECL:
        gen_var_decl(ast, out, src)
        
    else if ast.kind == AST_VAR_ASS:
        gen_var_ass(ast, out, src)
        
    else if ast.kind == AST_WHILE:
        gen_while(ast, out, src)
        
    else if ast.kind == AST_FOR:
        gen_for(ast, out, src)
        
    else if ast.kind == AST_FLOW_CONTROL: 
        base: @Token = ast.data._flow_ctrl.base   
        if base.kind == TOKEN_RETURN:
            gen_return(ast, out, src)
        else if base.kind == TOKEN_CONTINUE:
            gen_continue(ast, out, src)
        else if base.kind == TOKEN_BREAK:
            gen_break(ast, out, src)
        else:
            base: @Token = ast.data._flow_ctrl.base
            printf("%s%s:%d:%d: error:%s Unexpected token: %s\n", RED, current_file, get_line(src, base.start), get_col(src, base.start), RESET, token_kind_name(base.kind))
            exit(1)
        end

    else if ast.kind == AST_FUNC_CALL: 
        gen_func_call(ast, out, src)
        fprintf(out, ";\n")
        
    else if ast.kind == AST_IF:
        gen_if(ast, out, src, 0)
        
    else if ast.kind == AST_DOT_ACCESS:
        object: @AST = ast.data._dot_access.object
        gen_expr(object, out, src)
        obj_kind: int = ast.data._dot_access.access_kind
        if obj_kind == ACCESS_ARROW:
            fprintf(out, "->%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
        else if obj_kind == ACCESS_DOT:
            fprintf(out, ".%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
        else:
            obj_kind: int = object.kind
            if obj_kind == AST_DOT_ACCESS:
                if object.data._dot_access.resolved_type.pointer_depth > 0:
                    fprintf(out, "->%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
                else:
                    fprintf(out, ".%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
                end

            else if obj_kind == AST_SUBSCRIPT:
                fprintf(out, ".%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)

            else:
                fprintf(out, "->%.*s", ast.data._dot_access.field_length, src + ast.data._dot_access.field_start)
            end
        end
        
        if ast.data._dot_access.value != null:
            fprintf(out, " = ")
            gen_expr(ast.data._dot_access.value, out, src)
            fprintf(out, ";\n")
        end

    else if ast.kind == AST_PRINT:
        if ast.data._print.value_type.base == TOKEN_STRING and ast.data._print.value_type.pointer_depth == 0 and ast.data._print.value_type.array_size == 0:
            fprintf(out, "flower_print_string(")
            gen_expr(ast.data._print.value, out, src)
            fprintf(out, ");\n")

        else if ast.data._print.value_type.base == TOKEN_CHAR and ast.data._print.value_type.pointer_depth == 1 and ast.data._print.value_type.array_size == 0:
            fprintf(out, "printf(\"%%s\", ")
            gen_expr(ast.data._print.value, out, src)
            fprintf(out, ");\n")

        else if ast.data._print.value_type.base == TOKEN_CHAR and ast.data._print.value_type.pointer_depth == 0:
            fprintf(out, "printf(\"%%c\", ")
            gen_expr(ast.data._print.value, out, src)
            fprintf(out, ");\n")

        else if ast.data._print.value_type.base == TOKEN_FLOAT or ast.data._print.value_type.base == TOKEN_DOUBLE:
            fprintf(out, "printf(\"%%f\", ")
            gen_expr(ast.data._print.value, out, src)
            fprintf(out, ");\n")
            
        else:
            fprintf(out, "printf(")
            gen_expr(ast.data._print.value, out, src)
            fprintf(out, ");\n")
        end
                
    else if ast.kind == AST_PRUNE:
        fprintf(out, "free(")
        gen_expr(ast.data._prune_free.ptr, out, src)
        fprintf(out, ");\n")
        
    else if ast.kind == AST_DEREF_ASS:
        fprintf(out, "*%.*s = ", ast.data._deref_ass.name_length, src + ast.data._deref_ass.name_start)
        gen_expr(ast.data._deref_ass.value, out, src)
        fprintf(out, ";\n")
        
    else if ast.kind == AST_SUBSCRIPT:
        gen_expr(ast.data._subscript.array, out, src)
        if ast.data._subscript.is_string:
            fprintf(out, ".data[")
        else:
            fprintf(out, "[")
        end
        gen_expr(ast.data._subscript.index, out, src)
        fprintf(out, "]")

        if ast.data._subscript.value != null:
            fprintf(out, " = ")
            gen_expr(ast.data._subscript.value, out, src)
        end
            
        fprintf(out, ";\n")
        
    else if ast.kind == AST_ALIAS_CALL:
        gen_expr(ast, out, src)
        fprintf(out, ";\n")

    else:
        printf("Unknown statement kind: %d\n", ast.kind)
        exit(1)
    end
end



// === SETUP ===

func codegen(mods: @ModuleSet, out: @FILE): void
    active_modules = mods

    if mods.count == 0:
        return
    end

    main_mod: @Module = mods.modules + 0
    emit_module(main_mod, out, "", 0, 0)
end